# ============================================================
# front-template — Development environment
# Used by: compose-dev.yaml (node container) + local npm run dev
# ============================================================

# ---- App ----
VITE_APP_TITLE=front-template [DEV]

# ---- API ----
# Leave empty so the Vite dev server proxy handles /api requests.
VITE_API_BASE_URL=

# Where the Vite proxy forwards /api calls.
# Running locally (npm run dev):  http://localhost:5080
# Running in Docker (compose-dev): http://host.docker.internal:5080
VITE_DEV_API_PROXY_TARGET=http://host.docker.internal:5080
