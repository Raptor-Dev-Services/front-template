# front-template - desarrollo local. Lo leen `npm run dev` (vite --mode dev) y compose-dev.yaml.
# Solo valores PUBLICOS: todo VITE_* se hornea en el bundle. Referencia completa: .env.example

VITE_APP_TITLE=front-template [DEV]

# Vacio: el navegador habla con el mismo origen (http://localhost:5179) y Vite reenvia /api.
VITE_API_BASE_URL=

# A donde reenvia el proxy de Vite. compose-dev.yaml lo sobreescribe con host.docker.internal.
VITE_DEV_API_PROXY_TARGET=http://localhost:5060

VITE_DEFAULT_LOCALE=es
VITE_SOFTWARE_VERSION=dev-local
