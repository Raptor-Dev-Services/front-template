# ============================================================
# front-template - referencia de variables de entorno
# ============================================================
#
# TODA variable VITE_* es PUBLICA: Vite la hornea en el bundle en tiempo de build y cualquiera
# puede leerla desde las DevTools del navegador. Aqui NUNCA va una llave privada, un secreto de
# firma ni una credencial: eso vive solo en el backend.
#
# Archivos versionados (solo valores publicos):
#   .env.dev      -> `npm run dev` (vite --mode dev) y compose-dev.yaml
#   .env.staging  -> `npm run build:staging`
# Cualquier otro .env.* esta en .gitignore. En la imagen Docker los valores llegan como
# build ARGs (ver Dockerfile), no desde estos archivos.

# ---- App ----
VITE_APP_TITLE=front-template

# ---- API ----
# ORIGEN de la API, SIN el prefijo /api (los servicios ya piden /api/...).
# Vacio = mismo origen: en desarrollo lo atiende el proxy de Vite (VITE_DEV_API_PROXY_TARGET).
# En un build desplegado: el origen completo, p. ej. https://api.example.com
VITE_API_BASE_URL=

# Solo lo usa el servidor de desarrollo de Vite (no se hornea en el build).
# Local (npm run dev): http://localhost:5060   Desde Docker: http://host.docker.internal:5060
VITE_DEV_API_PROXY_TARGET=http://localhost:5060

# ---- i18n ----
# Idioma de arranque (es | en). La eleccion guardada del usuario manda sobre esto.
VITE_DEFAULT_LOCALE=es

# ---- Version ----
# Version mostrada en la UI. El pipeline de build la estampa.
VITE_SOFTWARE_VERSION=dev-local
