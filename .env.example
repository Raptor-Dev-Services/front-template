# ============================================================
# front-template — Environment Variables Reference
# Copy to .env.dev or .env.staging and fill in your values.
# NEVER commit .env or .env.*.local files.
# ============================================================

# ---- App ----
VITE_APP_TITLE=front-template

# ---- API ----
# Base URL consumed by Axios at runtime.
# In dev: leave empty — Vite proxies /api → VITE_DEV_API_PROXY_TARGET.
# In production/staging builds: set to the full API origin.
VITE_API_BASE_URL=

# Proxy target used only by the Vite dev server (not baked into the build).
# From Docker: use host.docker.internal instead of localhost.
VITE_DEV_API_PROXY_TARGET=http://localhost:5080
