# ============================================================
# front-template — Staging environment
# Used by: docker build --build-arg BUILD_MODE=staging
# Build command: npm run build -- --mode staging
# ============================================================

# ---- App ----
VITE_APP_TITLE=front-template [STAGING]

# ---- API ----
# Full origin of the staging API — baked into the JS bundle at build time.
VITE_API_BASE_URL=https://api.staging.example.com

# Not used in staging builds (proxy only applies to Vite dev server).
VITE_DEV_API_PROXY_TARGET=
