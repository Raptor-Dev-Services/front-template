# front-template - staging. Lo lee `npm run build:staging` (vite build --mode staging).
# Solo valores PUBLICOS: todo VITE_* se hornea en el bundle. Referencia completa: .env.example
# En la imagen Docker estos valores llegan como build ARGs; este archivo no entra al contexto.

VITE_APP_TITLE=front-template [STAGING]

# ORIGEN de la API de staging, sin /api.
VITE_API_BASE_URL=https://api.staging.example.com

VITE_DEFAULT_LOCALE=es
VITE_SOFTWARE_VERSION=staging
