# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/

# Vite cache
.vite/
*.local

# Environment. Se versionan SOLO los archivos de valores publicos (.env.example, .env.dev,
# .env.staging): todo VITE_* termina horneado en el bundle, asi que ahi no puede haber secretos.
# Cualquier otra variante (.env, .env.local, .env.produccion, .env.respaldo...) queda ignorada: con
# una lista de nombres concretos, un `.env.produccion` aparecia como untracked -indistinguible de un
# archivo nuevo cualquiera- y era commiteable.
.env
.env.*
!.env.example
!.env.dev
!.env.staging

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
Desktop.ini

# TypeScript
*.tsbuildinfo

# Testing
coverage/

# Claude Code: .claude/ SI se versiona (agentes, skills y reglas del catalogo instalados en el
# repo). Solo se ignora lo que es de la maquina o de la sesion.
.claude/settings.local.json
.claude/worktrees/

# docs/Tailwind Plus — build artifacts y deps (nunca commitear binarios generados)
docs/Tailwind Plus/component-library/node_modules/
docs/Tailwind Plus/component-library/dist/
docs/Tailwind Plus/component-library/.vite/
# node_modules y build outputs dentro de los website templates
docs/Tailwind Plus/Modern website templates, crafted with Tailwind CSS/**/node_modules/
docs/Tailwind Plus/Modern website templates, crafted with Tailwind CSS/**/.next/
docs/Tailwind Plus/Modern website templates, crafted with Tailwind CSS/**/dist/
docs/Tailwind Plus/Modern website templates, crafted with Tailwind CSS/**/.nuxt/
docs/Tailwind Plus/Modern website templates, crafted with Tailwind CSS/**/out/
